{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "AI CLI Sidebar (AGY / Claude 侧边栏)",
  "version": "1.1.0",
  "description": "使用本地 AI CLI (agy / claude / gemini / codex) 驱动的浏览器侧边栏，支持一键网页总结、划词/全文翻译、截屏翻译与多轮追问，不受地区限制。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 AI CLI 侧边栏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开或关闭 AI CLI 侧边栏"
    }
  }
}
